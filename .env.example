DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional — defaults to SQLite when absent
DATABASE_URL=

# Optional — Redis for caching + Celery. App works without it using in-memory fallbacks.
REDIS_URL=redis://localhost:6379/0

# Set True to run Celery tasks synchronously (useful for dev without a worker)
CELERY_TASK_ALWAYS_EAGER=True
